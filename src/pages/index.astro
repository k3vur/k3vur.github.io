---
import Layout from "../layouts/Layout.astro";
import Eyebrow from "../components/Eyebrow.astro";

// Welcome to Astro! Wondering what to do next? Check out the Astro documentation at https://docs.astro.build
// Don't want to use any of this? Delete everything in this file, the `assets`, `components`, and `layouts` directories, and start fresh.
---

<Layout language="en">
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Kevin Urban",
      url: "https://kevur.me/",
      jobTitle: "Software Engineer",
      email: "mailto:kevin.urban@icloud.com",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Baden-Württemberg, Germany",
      },
      sameAs: [
        "https://github.com/k3vur",
        "https://www.linkedin.com/in/kevin-urban-38bb46100/",
      ],
    })}
  />
  <div class="flex flex-col gap-s5 pt-s6 pb-s5">
    <section>
      <Eyebrow>Software Engineer</Eyebrow>
      <h1 class="font-medium mt-s2 mb-s3 text-display md:text-display-lg">
        Hi, I'm Kevin Urban.
      </h1>
      <p
        class="font-serif text-sub md:text-sub-lg leading-lede mb-s3 text-ink-soft"
      >
        I build full stack software and occasionally talk about the process of
        building it.
      </p>
      <div class="flex font-mono text-meta text-muted mb-s4 gap-s1">
        <span>BW, Germany</span> &middot;
        <span>kevin.urban@icloud.com</span> &middot;
        <span>he/him</span> &middot;
        <a
          class="text-accent whitespace-nowrap flex gap-0.5 hover:text-accent-strong hover:underline underline-offset-4"
          href="https://github.com/k3vur"
          target="_blank"
          rel="me noopener noreferrer"
          >GitHub <span aria-hidden>&#x2197;</span></a
        >&middot;
        <a
          class="text-accent whitespace-nowrap flex gap-0.5 hover:text-accent-strong hover:underline underline-offset-4"
          href="https://www.linkedin.com/in/kevin-urban-38bb46100/"
          target="_blank"
          rel="me noopener noreferrer"
          >LinkedIn <span aria-hidden>&#x2197;</span></a
        >
      </div>
    </section>

    <section
      class="max-w-max-text text-ink-soft gap-s2 text-body m-0 flex flex-col"
    >
      <p>
        I have been a professional Software Engineer since 2014, although I
        studied Computer Science for 5 years before that and started coding even
        earlier than that. I care about code and everything that relates to it,
        whether it's trying to find the best and simplest abstraction, enabling
        my team to ship more consistently, or talking to users to find out how
        the next feature can help them best.
      </p>
      <p>
        Whenever I get the opportunity, I also like to talk about building
        software or publish what I build privately. This is my showcase for
        that.
      </p>
    </section>

    <section
      class="max-w-max-text text-ink-soft gap-s2 text-body m-0 flex flex-col"
    >
      <Eyebrow>Now</Eyebrow>
      <p>
        Most recently, I've been a Senior Full Stack Engineer at DeepL, building
        the internal language data platform. Since recent layoffs, I'm open for
        new challenges.
      </p>
      <p>
        Want to get in contact? Email me at <a
          class="text-accent hover:text-accent-strong hover:underline"
          href="mailto:kevin.urban@icloud.com">kevin.urban@icloud.com!</a
        >
      </p>
    </section>

    <section
      class="py-s5 gap-y-s5 divide-hairline grid grid-cols-1 items-start divide-y md:grid-cols-2 md:gap-y-0 md:divide-x md:divide-y-0"
    >
      <div class="pt-s5 md:pt-0 flex flex-col gap-s3">
        <div class="flex items-baseline justify-between gap-s2 pr-s3">
          <h2 class="text-sub">Selected Projects</h2>
          <a
            class="text-meta tracking-meta text-accent hover:text-accent-strong font-mono whitespace-nowrap uppercase hover:underline hover:underline-offset-4"
            href="/projects">All Projects &rarr;</a
          >
        </div>
      </div>
      <div class="pt-s5 md:pt-0 flex flex-col gap-s3">
        <div class="flex items-baseline justify-between gap-s2 pl-s3">
          <h2 class="text-sub">Talks</h2>
          <a
            class="text-meta tracking-meta text-accent hover:text-accent-strong font-mono whitespace-nowrap uppercase hover:underline hover:underline-offset-4"
            href="/talks">All talks &rarr;</a
          >
        </div>
      </div>
    </section>
  </div>
</Layout>
