---
import Lede from "../components/head/Lede.astro";
import PageTitle from "../components/head/PageTitle.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Section from "../components/Section.astro";
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
const projects = (await getCollection("projects")).toSorted(
  (p1, p2) => p2.data.year - p1.data.year,
);
---

<Layout language="en">
  <Section>
    <PageTitle>Projects</PageTitle>
    <Lede>
      A few things I have built and open-sourced: small tools, apps, libs and
      the site you are reading right now.
    </Lede>
  </Section>
  <Section class="gap-s3 grid grid-cols-2 md:grid-cols-3">
    {projects.map((project) => <ProjectCard project={project.data} />)}
  </Section>
</Layout>
