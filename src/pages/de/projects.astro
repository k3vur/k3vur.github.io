---
import Lede from "@/components/head/Lede.astro";
import PageTitle from "@/components/head/PageTitle.astro";
import Link from "@/components/Link.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import Section from "@/components/Section.astro";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
const projects = (await getCollection("projects")).toSorted(
  (p1, p2) => p2.data.year - p1.data.year,
);
---

<Layout language="de">
  <Section>
    <PageTitle>Projekte</PageTitle>
    <Lede>
      Ein paar Dinge, die ich gebaut und als Open Source veröffentlicht habe:
      kleine Tools, Apps, Libs und die Seite, die du gerade liest. Die
      unkuratierte vollständige Liste meiner Experimente findest du auf
      <Link href="https://github.com/k3vur">GitHub</Link>
    </Lede>
  </Section>
  <Section class="gap-s3 grid grid-cols-2 md:grid-cols-3">
    {projects.map((project) => <ProjectCard project={project.data} />)}
  </Section>
</Layout>
