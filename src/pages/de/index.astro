---
import Layout from "@/layouts/Layout.astro";
import Eyebrow from "@/components/head/Eyebrow.astro";
import { Image } from "astro:assets";
import Portrait from "@/assets/kevin_urban.jpg";
import Link from "@/components/Link.astro";
import { getCollection } from "astro:content";
import ProjectCard from "@/components/ProjectCard.astro";
import Section from "@/components/Section.astro";
import PageTitle from "@/components/head/PageTitle.astro";
import Lede from "@/components/head/Lede.astro";
import TalkListItem from "@/components/TalkListItem.astro";
import { MoveRight } from "@lucide/astro";

const projects = (await getCollection("projects"))
  .toSorted((p1, p2) => p2.data.year - p1.data.year)
  .slice(0, 3);

const talks = (await getCollection("talks"))
  .toSorted((p1, p2) => p2.data.year - p1.data.year)
  .slice(0, 3);
---

<Layout language="de">
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      name: "Kevin Urban",
      url: "https://kevur.me/",
      jobTitle: "Software Engineer",
      email: "mailto:kevin.urban@icloud.com",
      address: {
        "@type": "PostalAddress",
        addressLocality: "Baden-Württemberg, Germany",
      },
      sameAs: [
        "https://github.com/k3vur",
        "https://www.linkedin.com/in/kevin-urban-38bb46100/",
      ],
    })}
  />
  <Section class="items-center md:flex-row md:items-start">
    <div class="md:max-w-max-text max-w-full flex-1">
      <PageTitle>
        Ich bin Kevin Urban<br />
        Ich baue leidenschaftlich gern Full-Stack-Software.
      </PageTitle>
      <Lede>
        Manchmal liegt mir das Bauen so sehr am Herzen, dass ich darüber rede
        oder ein Projekt veröffentliche.
      </Lede>
      <div
        class="text-meta text-muted mb-s4 gap-y-s0 *:not-last:after:mx-s0 flex flex-wrap font-mono text-nowrap *:not-last:after:content-['·']"
      >
        <span>BW, Deutschland</span>
        <span>er/ihm</span>
        <span class="flex">
          <Link href="mailto:kevin.urban@icloud.com">
            kevin.urban@icloud.com
          </Link>
        </span>
        <span class="flex">
          <Link href="https://github.com/k3vur" rel="me noopener noreferrer">
            GitHub
          </Link>
        </span>
        <span class="flex">
          <Link
            href="https://www.linkedin.com/in/kevin-urban-38bb46100/"
            rel="me noopener noreferrer"
          >
            LinkedIn
          </Link>
        </span>
      </div>
    </div>
    <div class="text-center">
      <Image
        class="rounded-card border-hairline aspect-3/4 w-3xs border shadow-xs"
        src={Portrait}
        alt="Profilbild"
      />
    </div>
  </Section>

  <Section>
    <p>
      Seit 2014 arbeite ich beruflich als Software Engineer, davor habe ich fünf
      Jahre Informatik studiert und noch früher mit dem Programmieren begonnen.
      Code und alles, was damit zusammenhängt, liegt mir am Herzen – sei es die
      Suche nach der besten und einfachsten Abstraktion, mein Team dabei zu
      unterstützen, verlässlicher auszuliefern, oder Gespräche mit Nutzenden, um
      herauszufinden, wie das nächste Feature ihnen am besten hilft.
    </p>
    <p>
      Wann immer sich die Gelegenheit ergibt, rede ich auch gern über
      Softwareentwicklung oder veröffentliche, was ich privat baue. Das hier ist
      meine Ausstellung dafür.
    </p>
  </Section>

  <Section>
    <Eyebrow>Jetzt</Eyebrow>
    <p>
      Zuletzt war ich als Senior Full Stack Engineer bei DeepL tätig und habe
      die interne Sprachdatenplattform mitentwickelt. Nach dem jüngsten
      Stellenabbau bin ich offen für neue Herausforderungen.
    </p>
    <p>
      Lust auf Kontakt? Schreib mir an <Link
        href="mailto:kevin.urban@icloud.com">kevin.urban@icloud.com</Link
      >!
    </p>
  </Section>

  <Section
    class="py-s5 gap-y-s5 divide-hairline grid grid-cols-1 items-start divide-y md:grid-cols-2 md:gap-y-0 md:divide-x md:divide-y-0"
  >
    <div class="pt-s5 pr-s3 gap-s3 flex flex-col md:pt-0">
      <div class="gap-s2 flex items-baseline justify-between">
        <h2 class="text-sub">Aktuelle Projekte</h2>
        <Link
          href="/projects"
          class="text-meta tracking-meta font-mono whitespace-nowrap uppercase"
        >
          Alle Projekte &rarr;
        </Link>
      </div>
      <div class="gap-s3 grid grid-cols-1">
        {projects.map((p) => <ProjectCard project={p.data} />)}
      </div>
    </div>
    <div class="pt-s5 gap-s3 flex flex-col md:pt-0">
      <div class="gap-s2 md:ml-s1 flex items-baseline justify-between">
        <h2 class="text-sub">Aktuelle Talks</h2>
        <Link
          href="/talks"
          class="text-meta tracking-meta font-mono whitespace-nowrap uppercase"
        >
          Alle Talks <MoveRight />
        </Link>
      </div>
      <div class="border-hairline md:ml-s1 divide-hairline border-t border-b">
        {talks.map((t) => <TalkListItem talk={t} />)}
      </div>
    </div>
  </Section>
</Layout>
