---
import { Font } from "astro:assets";
import "../styles/global.css";
import LanguagePicker from "../components/LanguagePicker.astro";
import Navigation from "../components/Navigation.astro";
interface Props {
  language: "de" | "en";
}
const { language } = Astro.props;
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-newsreader" />
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-fira" />
    <meta name="generator" content={Astro.generator} />
    <title>kevur.me – Kevin Urban, Software Engineer</title>
  </head>
  <body>
    <header class="sticky top-0 z-10 bg-paper border-b border-b-hairline px-s3">
      <div
        class="flex flex-wrap md:flex-nowrap items-center gap-s3 py-s2 mx-auto max-w-wide box-border"
      >
        <a
          class="group font-mono font-medium text-lg tracking-tight text-ink whitespace-nowrap md:order-1"
          href="/"
        >
          kevur<span class="text-accent group-hover:text-accent-strong"
            >.me</span
          >
        </a>
        <LanguagePicker currentLanguage={language} class="md:order-3" />
        <Navigation />
      </div>
    </header>
    <slot />
  </body>
</html>
