---
import { Font } from "astro:assets";
import "../styles/global.css";
import LanguagePicker from "../components/LanguagePicker.astro";
import Navigation from "../components/Navigation.astro";
interface Props {
  language: "de" | "en";
}
const { language } = Astro.props;
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-newsreader" />
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-fira" />
    <meta name="generator" content={Astro.generator} />
    <title>kevur.me – Kevin Urban, Software Engineer</title>
  </head>
  <body>
    <header class="sticky top-0 z-10 bg-paper border-b border-b-hairline px-s3">
      <div
        class="flex flex-wrap md:flex-nowrap items-center gap-s3 py-s2 mx-auto max-w-wide"
      >
        <a
          class="group font-mono font-medium text-lg tracking-tight text-ink whitespace-nowrap md:order-1"
          href="/"
        >
          kevur<span class="text-accent group-hover:text-accent-strong"
            >.me</span
          >
        </a>
        <LanguagePicker currentLanguage={language} class="md:order-3" />
        <Navigation />
      </div>
    </header>
    <main class="px-s3">
      <div class="mx-auto max-w-wide">
        <slot />
      </div>
    </main>
    <footer
      class="border-t border-t-hairline mt-s6 py-s4 text-muted text-small px-s3"
    >
      <div class="flex justify-between gap-s2 flex-wrap mx-auto max-w-wide">
        <div>&copy; 2026 kevur.me</div>
        <div class="flex gap-5 flex-wrap">
          <a
            class="text-ink-soft hover:text-accent"
            href="mailto:kevin.urban@icloud.com">Email</a
          >
          <a
            class="text-ink-soft hover:text-accent"
            href="https://github.com/k3vur"
            rel="me">GitHub</a
          >
          <a
            class="text-ink-soft hover:text-accent"
            href="https://www.linkedin.com/in/kevin-urban-38bb46100/"
            >LinkedIn</a
          >
        </div>
      </div>
    </footer>
  </body>
</html>
