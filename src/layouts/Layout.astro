---
import { Font } from "astro:assets";
import "../styles/global.css";
import LanguagePicker from "../components/LanguagePicker.astro";
import Navigation from "../components/Navigation.astro";
interface Props {
  language: "de" | "en";
  title?: string;
  description?: string;
  /** Absolute URL of this page; defaults to the homepage. */
  url?: string;
}
const {
  language,
  title = "kevur.me – Kevin Urban, Software Engineer",
  description = "Kevin Urban is a full-stack software engineer based in Baden-Württemberg, Germany, building software since 2014.",
  url = "https://kevur.me/",
} = Astro.props;
const siteName = "kevur.me";
// NOTE: an og:image is intentionally omitted until a share image asset exists.
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={url} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-newsreader" />
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-fira" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={url} />
  </head>
  <body>
    <header class="bg-paper border-b-hairline px-s3 sticky top-0 z-10 border-b">
      <div
        class="gap-s2 md:gap-s3 py-s1h max-w-max-width mx-auto flex flex-wrap items-center md:flex-nowrap"
      >
        <a
          class="text-body group text-ink font-mono text-lg font-medium tracking-tight whitespace-nowrap md:order-1"
          href="/"
        >
          kevur<span class="text-accent group-hover:text-accent-strong"
            >.me</span
          >
        </a>
        <LanguagePicker currentLanguage={language} class="md:order-3" />
        <Navigation />
      </div>
    </header>

    <main class="px-s3">
      <div class="max-w-max-width mx-auto">
        <slot />
      </div>
    </main>

    <footer
      class="border-t-hairline mt-s6 py-s4 text-muted text-small px-s3 border-t"
    >
      <div
        class="gap-s2 max-w-max-width mx-auto flex flex-wrap justify-between"
      >
        <div>&copy; 2026 kevur.me</div>
        <div class="gap-s3 flex flex-wrap">
          <a
            class="text-ink-soft hover:text-accent"
            href="mailto:kevin.urban@icloud.com">Email</a
          >
          <a
            class="text-ink-soft hover:text-accent"
            href="https://github.com/k3vur"
            rel="me">GitHub</a
          >
          <a
            class="text-ink-soft hover:text-accent"
            href="https://www.linkedin.com/in/kevin-urban-38bb46100/"
            >LinkedIn</a
          >
        </div>
      </div>
    </footer>
  </body>
</html>
