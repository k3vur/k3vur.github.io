---
const navItems = [
  { href: "/", label: "About me" },
  { href: "/projects", label: "Projects" },
  { href: "/talks", label: "Talks" },
  { href: "/cv", label: "CV" },
];
---

<nav
  class="gap-s3 mx-0 flex w-full flex-wrap md:ml-auto md:w-auto md:flex-nowrap"
  aria-label="Primary"
>
  {
    navItems.map(({ href, label }) => (
      <a
        class="text-ink-soft text-small py-s0 hover:text-ink hover:border-b-accent border-b border-b-transparent"
        href={href}
        aria-current={Astro.routePattern === href ? "page" : undefined}
      >
        {label}
      </a>
    ))
  }
</nav>
