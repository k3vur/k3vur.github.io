---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations } from "@/lib/i18n";

const indexUrl = getRelativeLocaleUrl(Astro.currentLocale!, "/");
const projectsUrl = getRelativeLocaleUrl(Astro.currentLocale!, "/projects");
const talksUrl = getRelativeLocaleUrl(Astro.currentLocale!, "/talks");
const cvUrl = getRelativeLocaleUrl(Astro.currentLocale!, "/cv");

const t = useTranslations(Astro.currentLocale!);
---

<nav
  class="gap-s3 mx-0 flex w-full flex-wrap md:order-2 md:mx-auto md:w-auto md:flex-nowrap"
  aria-label="Primary"
>
  <a
    class="text-ink-soft text-small py-s0 hover:text-ink hover:border-b-accent border-b border-b-transparent"
    href={indexUrl}
    aria-current={Astro.routePattern === indexUrl ? "page" : undefined}
    >{t("navigation.about-me")}</a
  >
  <a
    class="text-ink-soft text-small py-s0 hover:text-ink hover:border-b-accent border-b border-b-transparent"
    href={projectsUrl}
    aria-current={Astro.routePattern === projectsUrl ? "page" : undefined}
    >{t("navigation.projects")}</a
  >
  <a
    class="text-ink-soft text-small py-s0 hover:text-ink hover:border-b-accent border-b border-b-transparent"
    href={talksUrl}
    aria-current={Astro.routePattern === talksUrl ? "page" : undefined}
    >{t("navigation.talks")}</a
  >
  <a
    class="text-ink-soft text-small py-s0 hover:text-ink hover:border-b-accent border-b border-b-transparent"
    href={cvUrl}
    aria-current={Astro.routePattern === cvUrl ? "page" : undefined}
    >{t("navigation.cv")}</a
  >
</nav>
