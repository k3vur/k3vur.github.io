---
import { cn } from "../lib/cn";
import { ExternalLink } from "@lucide/astro";

interface Props {
  href: string;
  rel?: string;
  class?: string;
}
const { href, rel, class: className } = Astro.props;
const isExternal = href.startsWith("http");
---

<a
  class={cn(
    "text-accent hover:text-accent-strong gap-s0 inline-flex items-baseline whitespace-nowrap underline-offset-4 hover:underline",
    className,
  )}
  href={href}
  rel={rel}
  target={isExternal ? "_blank" : "_self"}
>
  <slot />
  {isExternal && <ExternalLink />}
</a>
