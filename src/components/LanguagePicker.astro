---
import { cn } from "@/lib/cn";
import { localizedUrl } from "@/lib/i18n";
import { cva } from "class-variance-authority";
interface Props {
  class: string;
  currentLanguage: "de" | "en";
}
const { class: className, currentLanguage } = Astro.props;
const languageButton = cva(
  ["text-muted py-s0 px-s1 hover:text-ink rounded-full"],
  {
    variants: {
      active: {
        true: ["text-accent-strong bg-accent-soft font-medium"],
        false: null,
      },
    },
  },
);

const enUrl = localizedUrl("en", Astro.routePattern);
const deUrl = localizedUrl("de", Astro.routePattern);
---

<div
  class={cn(
    "gap-s1 text-micro tracking-meta flex items-center font-mono",
    className,
  )}
  role="group"
  aria-label="Language"
>
  <a
    href={enUrl}
    aria-current={currentLanguage === "en" ? "page" : undefined}
    class={languageButton({ active: currentLanguage === "en" })}>EN</a
  >
  <span class="text-hairline" aria-hidden="true">/</span>
  <a
    href={deUrl}
    aria-current={currentLanguage === "de" ? "page" : undefined}
    class={languageButton({ active: currentLanguage === "de" })}>DE</a
  >
</div>
