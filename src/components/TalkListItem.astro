---
import Badge from "./Badge.astro";
import type { CollectionEntry } from "astro:content";

interface Props {
  talk: CollectionEntry<"talks">;
}

const { talk } = Astro.props;
const href = talk.data.type === "reveal" ? `/talks/${talk.id}` : talk.data.path;
const action = talk.data.type === "reveal" ? "Slides →" : "PDF ↓";
---

<a class="group pt-s2 pb-s1h gap-y-s1h flex flex-col" href={href}>
  <span class="text-meta text-muted gap-s1 flex items-baseline font-mono">
    <time>{talk.data.year}</time>
    {
      talk.data.language === "de" && (
        <Badge class="bg-warm-soft text-warm">{talk.data.language}</Badge>
      )
    }
    <span class="text-accent group-hover:text-accent-strong transition-colors"
      >{action}</span
    >
  </span>
  <span
    class="text-h3 leading-display text-ink group-hover:text-accent font-serif transition-colors"
    >{talk.data.title}</span
  >
  <span class="text-muted text-small">{talk.data.description}</span>
</a>
